# Copy to .env and adjust. .env is gitignored.

SECRET_KEY=django-insecure-dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase: copy the Session pooler URI from Project -> Connect and replace the
# password placeholder. Percent-encode special characters in the password.
# Session pooler (port 5432) is recommended for this persistent Django app.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# DB_CONN_MAX_AGE=60
# DB_CONN_HEALTH_CHECKS=True
# DB_CONNECT_TIMEOUT=10

# Local PostgreSQL fallback (used only when DATABASE_URL is unset).
POSTGRES_DB=calendar_audit
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Google OAuth. Download the OAuth 2.0 Client ID JSON from the Google Cloud
# console and save it at the path below. token.json is written on first
# authorisation.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Must be registered verbatim as an Authorized redirect URI on the OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth2/callback/

# Timezone used to bucket events into weeks/months in the report.
REPORT_TIME_ZONE=America/Chicago

# Public HTTPS base URL that Google uses to deliver push notifications.
# Production: set to your real domain, e.g. https://app.example.com
# Local dev: leave unset and run `python manage.py dev_watch` after starting ngrok.
# PUBLIC_BASE_URL=https://app.example.com

# How many days a Google push-notification channel lasts before renewal (default 7).
# WATCH_EXPIRATION_DAYS=7

# Required when PUBLIC_BASE_URL is set so Django accepts the HTTPS origin.
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# ALLOWED_HOSTS already includes *.ngrok-free.dev / *.ngrok-free.app in DEBUG.
